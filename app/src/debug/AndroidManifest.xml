<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds have their own name, so they're easy to tell from a release installed beside
     them. Set on the application, rather than by overriding app_name, so that translations of
     app_name don't hide it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/app_name_dev"
        tools:replace="android:label" />
</manifest>
